CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
# One core, 8 KiB kernel stacks, and a fork backend that copies up to
# 512 KiB in switch_mm: nothing here has a use for kernel preemption.
# CONFIG_PREEMPT is not set
CONFIG_PREEMPT_NONE=y
# VIRT_CPU_ACCOUNTING_GEN would select CONTEXT_TRACKING_USER_FORCE,
# which adds work to every syscall and exception return to exercise
# NO_HZ_FULL. This board is NO_HZ_IDLE, so it pays for nothing.
CONFIG_TICK_CPU_ACCOUNTING=y
# CONFIG_INITRAMFS_PRESERVE_MTIME is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
# CONFIG_FHANDLE is not set
# CONFIG_BASE_FULL is not set
# CONFIG_EPOLL is not set
# CONFIG_SIGNALFD is not set
# CONFIG_TIMERFD is not set
# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_ADVISE_SYSCALLS is not set
# CONFIG_MEMBARRIER is not set
# CONFIG_KALLSYMS is not set
# CONFIG_PERF_EVENTS is not set
CONFIG_XTENSA_VARIANT_CUSTOM=y
CONFIG_XTENSA_VARIANT_CUSTOM_NAME="esp32s3"
# CONFIG_XTENSA_VARIANT_MMU is not set
CONFIG_XTENSA_UNALIGNED_USER=y
CONFIG_USER_ABI_CALL0_ONLY=y
CONFIG_XTENSA_PLATFORM_ESP32=y
CONFIG_USE_OF=y
CONFIG_BUILTIN_DTB_NAME="esp32s3-devkit-c1"
CONFIG_MEMMAP_CACHEATTR=0xffff222f
CONFIG_KERNEL_LOAD_ADDRESS=0x42140000
CONFIG_XTENSA_VECTORS_SEPARATE=y
# Where core 0 leaves room for our vectors. It follows the firmware: its
# space_for_vectors symbol moved by a page when the watchdogs were
# enabled. package-final.py reads the address out of the firmware ELF
# and refuses to package an image where the two disagree.
CONFIG_VECTORS_ADDR=0x40380000
CONFIG_XIP_DATA_ADDR=0x3d800000
CONFIG_DEFAULT_MEM_START=0x3d800000
# CONFIG_SECCOMP is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_COREDUMP is not set
CONFIG_MMAP_ALLOW_UNINITIALIZED=y
# CONFIG_VM_EVENT_COUNTERS is not set
CONFIG_NET=y
CONFIG_PACKET=y
# CONFIG_PACKET_DIAG is not set
CONFIG_UNIX=y
# CONFIG_UNIX_DIAG is not set
CONFIG_INET=y
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_IP_MULTIPLE_TABLES is not set
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_DNS_RESOLVER is not set
CONFIG_CFG80211=y
# CONFIG_CFG80211_DEFAULT_PS is not set
# CONFIG_CFG80211_CRDA_SUPPORT is not set
# CONFIG_RFKILL is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# CONFIG_STANDALONE is not set
# CONFIG_PREVENT_FIRMWARE_BUILD is not set
# cfg80211 asks for regulatory.db before the rootfs is mounted, so it is
# built in (XIP: flash, not RAM). The path is relative to the kernel build
# directory, which build-kernel.sh populates.
CONFIG_EXTRA_FIRMWARE="regulatory.db regulatory.db.p7s"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"
# Nothing here loads firmware from userspace.
# CONFIG_FW_LOADER_USER_HELPER is not set
# CONFIG_ALLOW_DEV_COREDUMP is not set
CONFIG_MTD=y
# CONFIG_MTD_BLOCK is not set
CONFIG_MTD_ESP32=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y
CONFIG_NETDEVICES=y
# CONFIG_NET_CORE is not set
# CONFIG_ETHERNET is not set
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_CISCO is not set
CONFIG_ESP32_WIFI=y
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# The two side buttons need the input layer: GPIO0 through gpio-keys, and
# the AXP2101 power key through axp20x-pek. The latter requires the PMU
# interrupt, which needs GPIO7 pulled up (see the DTS).
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
# ATKBD is "default y" once INPUT_KEYBOARD is on, and it pulls in
# the whole SERIO PS/2 stack. This board has no PS/2 controller;
# the only keyboard is a USB one on the console port.
# CONFIG_KEYBOARD_ATKBD is not set
# MOUSE_PS2 is "default y" once INPUT_MOUSE is on and it also selects SERIO, so
# it drags in the same PS/2 stack. This board has neither.
# CONFIG_INPUT_MOUSE is not set
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y
# uinput: lets a userspace daemon inject key events. Needed for the BLE
# keyboard, whose HID reports arrive on a serial-ish pipe and have to become
# input events before the VT keyboard handler will see them.
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_AXP20X_PEK=y
# CONFIG_SERIO is not set
# Text console on the AMOLED.
#
# All four of these are needed and each fails silently on its own: VT is the
# text layer, VT_CONSOLE makes /dev/console the framebuffer, FRAMEBUFFER_CONSOLE
# binds fbcon to fb0, and FONT_8x16 gives it a font. With any one missing the
# panel still works as a framebuffer and no text ever appears on it.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Rotation adds a per-pixel pass over the whole screen; the panel is already
# the right way up.
# CONFIG_FRAMEBUFFER_CONSOLE_ROTATION is not set
CONFIG_FONTS=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y
# Framebuffer for the AMOLED. There was no display support of any kind in this
# config -- not even FB_SIMPLE -- so this is the first display subsystem on the
# board. cfb_* helpers do the fill/copy/blit so the driver only has to own the
# panel itself.
CONFIG_FB=y
CONFIG_FB_CO5300=y
CONFIG_SERIAL_ESP32=y
CONFIG_SERIAL_ESP32_ACM=y
CONFIG_HW_RANDOM_ESP32=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
# The bit-banged bus costs 34.6 percent of core 1 in kernel time on the touch
# daemon alone (KRN-005). Keep it buildable as the escape hatch, but the board
# runs the hardware controller.
CONFIG_I2C_GPIO=y
CONFIG_I2C_ESP32=y
# The watch has a PCF85063A on I2C 0x51, backed by VBACKUP, and it is the only
# clock on the board that survives power loss. hctosys is what makes it useful:
# it seeds the kernel clock before init, so timestamps and certificate checks
# are right without waiting for NTP.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_DRV_PCF85063=y
# RTC_NVMEM defaults to RTC_CLASS and pulls in the whole NVMEM framework.
# The PCF85063A has no nvmem this driver uses, and the board config ships
# with CONFIG_NVMEM off, so keep it off rather than growing the kernel.
# CONFIG_RTC_NVMEM is not set
# The AXP2101 PMIC at 0x34: MFD core plus the battery/USB power supplies.
# No mainline driver existed for the 2101, so this carries the pending
# "Add support for the X-Powers AXP2101 PMIC" series (Olivier Louvignes,
# 2026-10-23) which adds the variant to the axp20x family.
CONFIG_MFD_AXP20X=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_AXP20X=y
# Display power is not a PMU rail: it is XL9555 P07, a plain enable line.
# regulator-fixed with enable-gpios is what makes Linux assert it, instead of
# inheriting whatever the ESP-IDF firmware left behind. On a cold boot the
# expander comes up all-inputs and the panel would stay unpowered.
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# BATTERY_AXP20X and CHARGER_AXP20X depend on AXP20X_ADC, which depends on
# IIO. The battery driver reads the PMIC's ADC channels through that chain;
# the fuel-gauge percentage comes from the PMIC's own register instead.
# POWER_SUPPLY gates the whole drivers/power/supply menu: without it the
# AXP battery/charger symbols are not merely off, they do not exist in
# .config at all, which looks like a dependency failure and is really a
# missing parent menu.
CONFIG_POWER_SUPPLY=y
CONFIG_IIO=y
CONFIG_AXP20X_ADC=y
CONFIG_BATTERY_AXP20X=y
CONFIG_CHARGER_AXP20X=y
# The USB power-supply driver. It is what publishes /sys/class/power_supply/
# axp20x-usb, and it wants the two VBUS interrupts -- which only became
# available once the PMU IRQ was usable. Off by default in a minimal config,
# and its absence is silent: the battery still appears, so nothing looks wrong.
CONFIG_AXP20X_POWER=y
CONFIG_SPI=y
# Needed for the CO5300 panel: spi_transfer cannot express separate
# command/address/data phases with independent line widths.
CONFIG_SPI_MEM=y
CONFIG_SPI_ESP32=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SINGLE=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
# CONFIG_GPIO_CDEV_V1 is not set
CONFIG_GPIO_ESP32=y
CONFIG_GPIO_GENERIC_PLATFORM=y
# The XL9555 at I2C 0x20 is a PCA9555 clone: 16 bits, gating display power
# (P07), haptic enable (P06) and touch reset (P08). Without this nothing
# configures the expander, so its pins stay at the reset default of all-inputs
# and the board only works because the previous firmware left them driven.
CONFIG_GPIO_PCA953X=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
# CONFIG_HWMON is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VHOST_MENU is not set
CONFIG_COMMON_CLK_ESP32S3=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_SIMPLE=y
# CONFIG_NVMEM is not set
# CONFIG_DNOTIFY is not set
# CONFIG_INOTIFY_USER is not set
# CONFIG_MMC is not set
# CONFIG_PWRSEQ_EMMC is not set
# CONFIG_PWRSEQ_SIMPLE is not set
# CONFIG_MMC_SPI is not set
CONFIG_JFFS2_FS=y
CONFIG_JFFS2_COMPRESSION_OPTIONS=y
CONFIG_JFFS2_CMODE_NONE=y
CONFIG_CRAMFS=y
CONFIG_CRAMFS_MTD=y
# CONFIG_CRAMFS_BLOCKDEV is not set
# CONFIG_VFAT_FS is not set
# CONFIG_FAT_DEFAULT_UTF8 is not set
# CONFIG_NLS_CODEPAGE_437 is not set
# CONFIG_NLS_ISO8859_1 is not set
# CONFIG_NLS_UTF8 is not set
# CONFIG_NFS_FS is not set
CONFIG_INIT_STACK_NONE=y
CONFIG_PRINTK_TIME=y
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_DEBUG_MISC is not set
CONFIG_FRAME_WARN=1024
CONFIG_MAGIC_SYSRQ=y
# CONFIG_DEBUG_FS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SCHED_DEBUG is not set
CONFIG_STACKTRACE=y
# CONFIG_RCU_TRACE is not set
# CONFIG_FTRACE is not set
# CONFIG_LD_NO_RELAX is not set
# CONFIG_S32C1I_SELFTEST is not set
CONFIG_PRINT_USER_CODE_ON_UNHANDLED_EXCEPTION=y
# CONFIG_RUNTIME_TESTING_MENU is not set

# --- memory, on a board with 7008K available ---
# Source port randomisation sized for a host with thousands of outbound
# connections: the boot log shows "Table-perturb hash table entries: 65536
# (order: 6, 262144 bytes, linear)". Order 8 floors at one page.
CONFIG_INET_TABLE_PERTURB_ORDER=8
# The allocator variant meant for systems under 16 MiB.
CONFIG_SLUB_TINY=y
# 128 KiB of printk ring for a board that logs to a 115200 console. The
# diagnostic profile puts this back to 17.
CONFIG_LOG_BUF_SHIFT=14
# Two 256-entry tty_driver tables for a machine whose only pty user is
# dropbear, which goes through /dev/ptmx.
# CONFIG_LEGACY_PTYS is not set

# --- hardening ---
# TIOCSTI is the terminal injection primitive; /dev/mem on NOMMU has no
# STRICT_DEVMEM to limit it and would also reach core 0's PSRAM. Nothing in
# the tree opens /dev/mem.
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_DEVMEM is not set
CONFIG_SECURITY_DMESG_RESTRICT=y
# CONFIG_SUSPEND is not set
# CONFIG_INET_DIAG is not set
# CONFIG_ETHTOOL_NETLINK is not set
# CONFIG_BLOCK is not set
