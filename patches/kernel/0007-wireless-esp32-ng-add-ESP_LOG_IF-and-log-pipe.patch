From: Escapement
Subject: [PATCH] wireless: esp32-ng: add ESP_LOG_IF, and deliver the firmware log stream

The firmware fork added a seventh interface, ESP_LOG_IF, for its diagnostic
stream. This kernel's enum stopped at six, so the two disagreed on ESP_MAX_IF:

    kernel    ESP_MAX_IF      = 6
    firmware  ESP_LOG_IF      = 6   (added)
              ESP_MAX_IF      = 7

Every firmware log frame arrives tagged 6, fails the `if_type >= ESP_MAX_IF`
test in process_rx_buf(), and is dropped with "bad if_type 6" on the console.
The frames were never delivered anywhere either: /dev/esp-log did not exist,
because esp_log_pipe.c was carried in patches/kernel/display/final/ but the
build never installed or compiled it.

Both halves have to land together. Accepting ESP_LOG_IF without a consumer
would leave those skbs queued in rx_q forever, which is worse than dropping
them, so the driver is wired in the same patch as the enum entry.

esp_log_pipe.c itself is installed by scripts/build-kernel.sh from
patches/kernel/display/final/, so there is one copy of it in the tree.

---
--- a/drivers/net/wireless/espressif/esp32-ng/adapter.h
+++ b/drivers/net/wireless/espressif/esp32-ng/adapter.h
@@ -55,6 +55,12 @@
 	ESP_INTERNAL_IF,
 	ESP_TEST_IF,
 	ESP_BLE_PROV_IF,
+	/* Escapement: firmware diagnostics, a stream of its own. The firmware
+	 * fork added this as the seventh interface; this enum stopped at six, so
+	 * ESP_MAX_IF was 6 here and 7 there. Every log frame arrived tagged 6,
+	 * failed the if_type >= ESP_MAX_IF test in process_rx_buf() and was
+	 * dropped -- which is why the console carried "bad if_type 6". */
+	ESP_LOG_IF,
 	ESP_MAX_IF,
 };
 
--- a/drivers/net/wireless/espressif/esp32-ng/esp_api.h
+++ b/drivers/net/wireless/espressif/esp32-ng/esp_api.h
@@ -30,6 +30,9 @@
 int esp_ble_prov_init(struct esp_adapter *adapter);
 void esp_ble_prov_deinit(void);
 void esp_ble_prov_rx(struct sk_buff *skb);
+int esp_log_pipe_init(struct esp_adapter *adapter);
+void esp_log_pipe_deinit(void);
+void esp_log_pipe_rx(struct sk_buff *skb);
 u8 esp_is_bt_supported_over_sdio(u32 cap);
 void esp_tx_pause(struct esp_wifi_device *priv);
 void esp_tx_resume(struct esp_wifi_device *priv);
--- a/drivers/net/wireless/espressif/esp32-ng/main.c
+++ b/drivers/net/wireless/espressif/esp32-ng/main.c
@@ -505,6 +505,11 @@
 	RET_ON_FAIL(esp_add_network_ifaces(adapter));
 
 	esp_ble_prov_init(adapter);
+	/* Firmware diagnostics. Its failure is not fatal: without it the log
+	 * stream is dropped instead of delivered, which is exactly the state
+	 * this project was in before. */
+	if (esp_log_pipe_init(adapter))
+		esp_err("firmware log pipe unavailable\n");
 
 	return 0;
 }
@@ -600,6 +605,7 @@
 	esp_ble_prov_deinit();
 	esp_deinit_bt(adapter);
 #endif
+	esp_log_pipe_deinit();
 	esp_commands_teardown(adapter);
 	esp_remove_network_ifaces(adapter);
 	esp_remove_wiphy(adapter);
@@ -807,6 +813,9 @@
 	} else if (payload_header->if_type == ESP_BLE_PROV_IF) {
 		esp_ble_prov_rx(skb);
 		return;
+	} else if (payload_header->if_type == ESP_LOG_IF) {
+		esp_log_pipe_rx(skb);
+		return;
 	} else if (payload_header->if_type == ESP_TEST_IF) {
 #if TEST_RAW_TP
 		if (raw_tp_mode != 0) {
--- a/drivers/net/wireless/espressif/esp32-ng/Makefile
+++ b/drivers/net/wireless/espressif/esp32-ng/Makefile
@@ -1,5 +1,5 @@
 obj-$(CONFIG_ESP32_WIFI)		+= esp32-wifi.o
-esp32-wifi-objs				+= main.o esp_cmd.o esp_cfg80211.o esp_stats.o esp_utils.o esp_ble_prov.o
+esp32-wifi-objs				+= main.o esp_cmd.o esp_cfg80211.o esp_stats.o esp_utils.o esp_ble_prov.o esp_log_pipe.o
 esp32-wifi-$(CONFIG_ESP32_BT)		+= esp_bt.o
 esp32-wifi-$(CONFIG_ESP32_WIFI_SPI)	+= esp_spi.o
 esp32-wifi-$(CONFIG_ESP32_WIFI_SDIO)	+= esp_sdio.o
