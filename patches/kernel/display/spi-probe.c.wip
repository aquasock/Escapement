// spi-probe.c - does SPI2 work at all on this watch?
//
// Written because the CO5300 panel is write-only: it never tells you whether
// it received anything, so a driver can run every transaction "successfully"
// against a panel that is not listening. Debugging eight register-level faults
// with no feedback signal was the wrong way to work.
//
// The SX1262 LoRa radio on this board answers. It has a BUSY pin, a RESET pin,
// and GetStatus returns a byte describing its chip mode. That gives three
// independent pieces of evidence where the panel gives none:
//
//   1. BUSY moves after reset      -> the chip is powered and alive
//   2. GetStatus returns non-0xFF  -> MISO works, so the bus is bidirectional
//   3. the mode bits are plausible -> the whole transaction was framed right
//
// If this passes, the GPIO-matrix routing and the SPI2 register programming in
// co5300.c are correct and the panel's problem is in its own protocol. If it
// fails, the fault is in the bus and the panel was never the issue.
//
// Deliberately shares nothing with co5300.c: if both used the same helper, a
// bug in the helper would hide from both.

#include <linux/bitfield.h>
#include <linux/delay.h>
#include <linux/io.h>
#include <linux/module.h>
#include <linux/of.h>
#include <linux/platform_device.h>
#include <linux/regulator/consumer.h>

#define DRIVER_NAME "spi-probe"

// ---- panel bus is SPI2 at 0x60024000; this test uses the same peripheral ----
#define SPI_CMD_REG      0x00
#define SPI_USR          BIT(24)
#define SPI_UPDATE       BIT(23)
#define SPI_ADDR_REG     0x04
#define SPI_CTRL_REG     0x08
#define SPI_CLOCK_REG    0x0c
#define SPI_USER_REG     0x10
#define SPI_USER1_REG    0x14
#define SPI_USER2_REG    0x18
#define SPI_MS_DLEN_REG  0x1c
#define SPI_W0_REG       0x98
#define SPI_W8_REG       0xb8
#define SPI_SLAVE_REG    0xe0
#define SPI_SOFT_RESET   BIT(27)
#define SPI_CLK_GATE_REG 0xe8

#define SPI_USR_MOSI     BIT(27)
#define SPI_USR_MISO     BIT(28)
#define SPI_USR_ADDR     BIT(30)
#define SPI_USR_COMMAND  BIT(31)
#define SPI_CS_HOLD      BIT(6)

#define SPI_USR_ADDR_BITLEN    GENMASK(31, 27)
#define SPI_USR_COMMAND_VALUE  GENMASK(15, 0)
#define SPI_USR_COMMAND_BITLEN GENMASK(31, 28)
#define SPI_MS_DATA_BITLEN     GENMASK(17, 0)

#define SPI_CLK_EN        BIT(0)
#define SPI_MST_CLK_ACTIVE BIT(1)
#define SPI_MST_CLK_SEL   BIT(2)

// ---- GPIO matrix and IO_MUX ----
#define GPIO_OUT_SEL(n)  (0x554 + (n) * 4)
#define GPIO_IN_SEL(m)   (0x154 + (m) * 4)
#define GPIO_IN_REG      0x3c
#define GPIO_OUT_W1TS    (0x08)
#define GPIO_OUT_W1TC    (0x0c)
#define GPIO_ENABLE_W1TS (0x24)
#define GPIO_ENABLE_W1TC (0x28)

#define RDY_VAL          BIT(9)        // FUN_IE
#define RDY_WPU          BIT(8)        // FUN_WPU
#define MCU_SEL_GPIO     (1 << 12)     // bits 14:12
#define DRV_20MA         (2 << 10)     // bits 11:10

#define FSPICLK_OUT_IDX  101
#define FSPIQ_IN_IDX     102
#define FSPIQ_OUT_IDX    102
#define FSPID_OUT_IDX    103

// ---- pins (second SPI bus) ----
#define PIN_SCK   35
#define PIN_MOSI  34
#define PIN_MISO  33

/*
 * Target: ST25R3916 NFC, CS 4 / INT 5.
 *
 * Chosen over the SX1262 because LilyGo list the radio as "SX1262 or SX1280",
 * a variant option, while the NFC reader is standard equipment. It also has a
 * chip-identity register, so the answer is a value rather than a guess.
 *
 * ST25R3916 SPI framing (datasheet DS12484):
 *   register read  : first byte 0x40 | addr, then clock out the value
 *   register write : first byte 0x80 | addr, then data
 *   IC_IDENTITY    : 0x3F in register space A
 *   expected       0x05 for ST25R3916
 */
#define PIN_CS    4
#define PIN_IRQ   5

#define NFC_REG_IC_IDENTITY 0x3F
#define NFC_EXPECT_ID       0x05

static int io_mux_off(int pin)
{
	// Pins 39..45 are the JTAG/flash pads and are not at n*4. Pins 46..48
	// likewise. Values from io_mux_reg.h.
	switch (pin) {
	case 33: return 0x88;
	case 34: return 0x8c;
	case 35: return 0x90;
	case 47: return 0xc0;
	case 48: return 0xc4;
	default: return pin * 4;
	}
}

struct probe {
	void __iomem *spi;
	void __iomem *gpio;
	void __iomem *iomux;
};

static inline void sw(struct probe *p, int off, u32 v) { iowrite32(v, p->spi + off); }
static inline u32 sr(struct probe *p, int off) { return ioread32(p->spi + off); }

static void pin_out(struct probe *p, int pin, int sig)
{
	iowrite32(MCU_SEL_GPIO | DRV_20MA, p->iomux + io_mux_off(pin));
	iowrite32(sig, p->gpio + GPIO_OUT_SEL(pin));
	iowrite32(BIT(pin), p->gpio + GPIO_ENABLE_W1TS);
}

static void pin_gpio_out(struct probe *p, int pin)
{
	iowrite32(MCU_SEL_GPIO | DRV_20MA, p->iomux + io_mux_off(pin));
	iowrite32(BIT(pin), p->gpio + GPIO_ENABLE_W1TS);
}

static void pin_gpio_in(struct probe *p, int pin)
{
	iowrite32(MCU_SEL_GPIO | RDY_VAL, p->iomux + io_mux_off(pin));
	iowrite32(BIT(pin), p->gpio + GPIO_ENABLE_W1TC);
}

static void set_pin(struct probe *p, int pin, int v)
{
	iowrite32(BIT(pin), p->gpio + (v ? GPIO_OUT_W1TS : GPIO_OUT_W1TC));
}

static int get_pin(struct probe *p, int pin)
{
	return !!(ioread32(p->gpio + GPIO_IN_REG) & BIT(pin));
}

static void run(struct probe *p)
{
	int g;

	sw(p, SPI_CMD_REG, SPI_UPDATE);
	for (g = 0; g < 20000 && (sr(p, SPI_CMD_REG) & SPI_UPDATE); g++)
		cpu_relax();
	sw(p, SPI_CMD_REG, SPI_USR);
	for (g = 0; g < 20000 && (sr(p, SPI_CMD_REG) & SPI_USR); g++)
		cpu_relax();
	if (g >= 20000)
		pr_err("spi-probe: transaction never completed\n");
}

// Read one ST25R3916 register: command byte out, then clock a byte in.
static u8 nfc_read(struct probe *p, u8 reg, u32 ctrl)
{
	u32 user = SPI_USR_COMMAND | SPI_USR_MOSI | SPI_USR_MISO | SPI_CS_HOLD;

	// 1 MHz-ish; this is a liveness check, not a benchmark.
	sw(p, SPI_CLOCK_REG, FIELD_PREP(GENMASK(5, 0), 19) |
			     FIELD_PREP(GENMASK(11, 6), 9) |
			     FIELD_PREP(GENMASK(17, 12), 19));

	sw(p, SPI_USER2_REG, FIELD_PREP(SPI_USR_COMMAND_VALUE, 0x40 | (reg & 0x3F)) |
			     FIELD_PREP(SPI_USR_COMMAND_BITLEN, 7));
	sw(p, SPI_USER1_REG, 0);
	sw(p, SPI_CTRL_REG, ctrl);
	sw(p, SPI_USER_REG, user);
	sw(p, SPI_MS_DLEN_REG, FIELD_PREP(SPI_MS_DATA_BITLEN, 7));
	sw(p, SPI_W0_REG, 0x00);

	run(p);
	return sr(p, SPI_W0_REG) & 0xFF;
}


/*
 * Internal loopback: the only test on this board that needs nothing to answer.
 *
 * Every external target on the second SPI bus either does not respond or is
 * not fitted, so no experiment so far has actually proved that the peripheral
 * shifts bits. This one does, with no wire and no external part:
 *
 *   - MISO's pad is switched to OUTPUT
 *   - its matrix output selector is pointed at FSPID_OUT_IDX, the same signal
 *     the peripheral drives on MOSI
 *   - FSPIQ_IN stays mapped to that pad
 *
 * So whatever the peripheral shifts out on MOSI is looped straight back into
 * its own receive path. Shift 0xA5 (10100101) and the received byte must be the
 * same pattern; if the clock, data or phase is wrong it comes back shifted,
 * inverted or zero.
 */
static int spi_loopback(struct probe *p)
{
	static const u8 patterns[] = { 0xA5, 0x5A, 0xFF, 0x00, 0x81 };
	int i, pass = 0;

	/*
	 * Sanity check the pad's output driver before trusting any loopback
	 * result: drive GPIO33 as a plain GPIO and read it back. If this does
	 * not work, the pad never drives and loopback could never succeed.
	 */
	iowrite32(MCU_SEL_GPIO | DRV_20MA | RDY_VAL, p->iomux + io_mux_off(PIN_MISO));
	iowrite32(BIT(PIN_MISO), p->gpio + GPIO_ENABLE_W1TS);
	set_pin(p, PIN_MISO, 1);
	udelay(50);
	pr_info("spi-probe: pad33 driven high reads %d\n", get_pin(p, PIN_MISO));
	set_pin(p, PIN_MISO, 0);
	udelay(50);
	pr_info("spi-probe: pad33 driven low  reads %d\n", get_pin(p, PIN_MISO));

	// MISO pad -> output, driven by FSPID_OUT (the MOSI signal).
	iowrite32(MCU_SEL_GPIO | DRV_20MA, p->iomux + io_mux_off(PIN_MISO));
	iowrite32(FSPID_OUT_IDX, p->gpio + GPIO_OUT_SEL(PIN_MISO));
	iowrite32(BIT(PIN_MISO), p->gpio + GPIO_ENABLE_W1TS);
	iowrite32(PIN_MISO, p->gpio + GPIO_IN_SEL(FSPIQ_IN_IDX));

	for (i = 0; i < ARRAY_SIZE(patterns); i++) {
		u8 tx = patterns[i], rx;

		sw(p, SPI_CLOCK_REG, FIELD_PREP(GENMASK(5, 0), 19) |
				     FIELD_PREP(GENMASK(11, 6), 9) |
				     FIELD_PREP(GENMASK(17, 12), 19));
		sw(p, SPI_USER_REG, SPI_USR_MOSI | SPI_USR_MISO | SPI_CS_HOLD);
		sw(p, SPI_USER1_REG, 0);
		sw(p, SPI_USER2_REG, 0);
		sw(p, SPI_CTRL_REG, 0x00340000);
		sw(p, SPI_MS_DLEN_REG, FIELD_PREP(SPI_MS_DATA_BITLEN, 7));
		sw(p, SPI_W0_REG, tx);
		sw(p, SPI_W8_REG, 0);          // clear the receive slot
		run(p);
		rx = sr(p, SPI_W0_REG) & 0xFF;

		pr_info("spi-probe: loopback tx 0x%02X rx 0x%02X  %s\n", tx, rx,
			rx == tx ? "MATCH" : "differ");
		if (rx == tx)
			pass++;
	}

	// Restore MISO to an input so anything later is not fighting a driver.
	iowrite32(MCU_SEL_GPIO | RDY_VAL, p->iomux + io_mux_off(PIN_MISO));
	iowrite32(BIT(PIN_MISO), p->gpio + GPIO_ENABLE_W1TC);

	pr_info("spi-probe: LOOPBACK %d/%d -> %s\n", pass, (int)ARRAY_SIZE(patterns),
		pass == ARRAY_SIZE(patterns) ? "SPI PERIPHERAL WORKS" :
		pass ? "partial - phase or data width wrong" : "no data shifted");
	return pass;
}

static int spi_probe_probe(struct platform_device *pdev)
{
	struct device *dev = &pdev->dev;
	struct probe *p;
	u8 a, b;
	int i;
	static const char *const names[] = {
		"ctrl=0x00340000 (idf)", "ctrl=0x00000000 (plain)", NULL
	};
	static const u32 ctrls[] = { 0x00340000, 0x00000000 };

	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
	if (!p)
		return -ENOMEM;
	platform_set_drvdata(pdev, p);

	p->spi = devm_ioremap(dev, 0x60024000, 0x100);
	p->gpio = devm_ioremap(dev, 0x60004000, 0x800);
	p->iomux = devm_ioremap(dev, 0x60009000, 0x200);
	if (!p->spi || !p->gpio || !p->iomux)
		return -ENOMEM;

	pin_out(p, PIN_SCK, FSPICLK_OUT_IDX);
	pin_out(p, PIN_MOSI, FSPID_OUT_IDX);

	/*
	 * MISO must be INPUT ONLY.
	 *
	 * The first version used pin_out() for it, which enables the pad's
	 * output driver and points it at FSPIQ_OUT -- so the ESP32 was driving
	 * MISO low and fighting its own pull-up. That is why the line read 0
	 * no matter what, and why "held low by an unpowered chip" looked like a
	 * credible theory. The pad was holding itself low.
	 */
	iowrite32(MCU_SEL_GPIO | RDY_VAL, p->iomux + io_mux_off(PIN_MISO));
	iowrite32(BIT(PIN_MISO), p->gpio + GPIO_ENABLE_W1TC);
	iowrite32(PIN_MISO, p->gpio + GPIO_IN_SEL(FSPIQ_IN_IDX));

	/*
	 * Power the NFC explicitly. The rail is AXP2101 DLDO1 and it comes up
	 * off; relying on the DT regulator being applied left the reader
	 * unpowered, and an unpowered chip holds MISO low through its ESD
	 * diodes -- indistinguishable from a dead bus.
	 */
	{
		struct regulator *v = devm_regulator_get_optional(dev, "vdd");
		int rc;

		if (IS_ERR(v)) {
			pr_warn("spi-probe: no vdd supply (%ld) - assuming always-on\n",
				PTR_ERR(v));
		} else {
			rc = regulator_enable(v);
			pr_info("spi-probe: regulator enable -> %d, state %s\n",
				rc, regulator_is_enabled(v) ? "enabled" : "off");
			msleep(50);
		}
	}

	/*
	 * Loopback FIRST, before any external device is blamed. It needs
	 * nothing to answer: MISO's pad is driven by the peripheral's own
	 * data-out signal, so what is shifted out is shifted straight back in.
	 * If this fails, no device on the bus could ever have worked.
	 */
	spi_loopback(p);

	pin_gpio_out(p, PIN_CS);
	pin_gpio_in(p, PIN_IRQ);
	set_pin(p, PIN_CS, 1);

	sw(p, SPI_CLK_GATE_REG, SPI_CLK_EN | SPI_MST_CLK_ACTIVE | SPI_MST_CLK_SEL);
	sw(p, SPI_SLAVE_REG, SPI_SOFT_RESET);
	sw(p, SPI_SLAVE_REG, 0);

	/*
	 * The decisive test, and the one that should have come first.
	 *
	 * MISO reading a constant 0x00 is three different faults wearing one
	 * mask: the device may be driving low because it is unpowered, the line
	 * may be floating, or the input path may be broken so the peripheral
	 * sees a hard zero regardless.
	 *
	 * Pull-ups tell them apart. A floating line goes high when pulled up; a
	 * line held low by a real driver does not; and if the input path is
	 * broken it stays zero even with the pull-up on.
	 */
	for (i = 0; i < 2; i++) {
		int wpu = (i == 1);

		iowrite32(MCU_SEL_GPIO | RDY_VAL | (wpu ? RDY_WPU : 0),
			  p->iomux + io_mux_off(PIN_MISO));
		iowrite32(MCU_SEL_GPIO | RDY_VAL | (wpu ? RDY_WPU : 0),
			  p->iomux + io_mux_off(PIN_IRQ));
		iowrite32(BIT(PIN_MISO) | BIT(PIN_IRQ),
			  p->gpio + GPIO_ENABLE_W1TC);
		udelay(200);

		pr_info("spi-probe: %-8s  MISO=%d  IRQ=%d  (iomux33=0x%08x)\n",
			wpu ? "pull-up" : "np",
			get_pin(p, PIN_MISO), get_pin(p, PIN_IRQ),
			ioread32(p->iomux + io_mux_off(PIN_MISO)));
	}

	/*
	 * Control: GPIO0 is Pusher B, proven to work as an input earlier in this
	 * project. If a pull-up on GPIO0 reads 1 while the same treatment on
	 * GPIO33 reads 0, then the method is sound and GPIO33 really is being
	 * held low by something external -- meaning the NFC is absent, on a
	 * different pin, or damaged. If GPIO0 also reads 0, the fault is in how
	 * this driver touches pads, not in the board.
	 */
	iowrite32(MCU_SEL_GPIO | RDY_VAL | RDY_WPU, p->iomux + io_mux_off(0));
	iowrite32(BIT(0), p->gpio + GPIO_ENABLE_W1TC);
	udelay(200);
	pr_info("spi-probe: CONTROL gpio0 (known-good input) with pull-up = %d\n",
		get_pin(p, 0));

	// Now re-run the register read with the pull-up left on: if the value
	// changes from 0x00 to 0xFF, the input path works and the device is
	// simply not driving the bus.
	set_pin(p, PIN_CS, 0);
	a = nfc_read(p, NFC_REG_IC_IDENTITY, 0x00340000);
	set_pin(p, PIN_CS, 1);
	pr_info("spi-probe: IC_IDENTITY with pull-up -> 0x%02X %s\n", a,
		(a == 0xFF) ? "(all ones = line floats, device not driving)" :
		(a == NFC_EXPECT_ID) ? "*** MATCH ***" : "");

	return 0;
}

static void spi_probe_remove(struct platform_device *pdev) { }

static const struct of_device_id spi_probe_of[] = {
	{ .compatible = "escapement,spi-probe" },
	{ }
};
MODULE_DEVICE_TABLE(of, spi_probe_of);

static struct platform_driver spi_probe_driver = {
	.probe = spi_probe_probe,
	.remove = spi_probe_remove,
	.driver = { .name = DRIVER_NAME, .of_match_table = spi_probe_of },
};
module_platform_driver(spi_probe_driver);

MODULE_DESCRIPTION("SPI liveness probe against the T-Watch Ultra's SX1262");
MODULE_LICENSE("GPL");
