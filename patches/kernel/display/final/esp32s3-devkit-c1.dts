// SPDX-License-Identifier: GPL-2.0-or-later
/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/input/linux-event-codes.h>
#include "gpio-esp32.h"
#include "esp32s3.dtsi"

/ {
	memory@0 {
		device_type = "memory";
		reg = <0x3d800000 0x00800000>;
	};

	/*
	 * Hardware I2C0 at 0x60013000, not i2c-gpio.
	 *
	 * The bit-banged bus was an interim that cost 34.6 percent of core 1 in
	 * kernel time, because every clock edge is a GPIO toggle taken in
	 * software (KRN-005, docs/cores.md). The controller exists and LilyGo's
	 * own firmware drives this board's pins with it at 1 MHz.
	 *
	 * To go back to the bit-banged bus in a hurry, restore:
	 *	compatible = "i2c-gpio";
	 *	sda-gpios = <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	 *	scl-gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	 * and drop reg/interrupts/clock-frequency.
	 */
	/*
	 * I2C_EXT0's clock gate lives in SYSTEM_PERIP_CLK_EN0 (0x600c0018)
	 * bit 7, and its reset default is 0. Nothing had ever enabled it: the
	 * firmware does not use I2C, and the bit-banged bus needed no
	 * peripheral clock. Without it every register write to the controller
	 * is lost, which presents as a peripheral stuck in its reset state
	 * (ctr = 0x20b, master mode clear) while the driver reports success.
	 *
	 * Declared here rather than in esp32s3.dtsi so it travels with the
	 * board file this project carries whole.
	 */
	i2c0_clk: i2c0_clk {
		#clock-cells = <0>;
		compatible = "gpio-gate-clock";
		clocks = <&clk 2>;		/* apb_clk */
		enable-gpios = <&clk_gpio0 7 0>;
	};

	i2c0: i2c@60013000 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "espressif,esp32-i2c";
		reg = <0x60013000 0x100>;
		interrupts = <42 9 0>;	/* I2C_EXT0 source 42, external IRQ9 */
		clock-frequency = <100000>;
		clocks = <&i2c0_clk>;

		/* Pins are routed through the GPIO matrix by the driver, and
		 * their pull-ups and input-enable come from i2c0_pins below.
		 * SPI needs the same treatment: neither bus reaches these pads
		 * through IO_MUX. */
		espressif,sda-pin = <3>;
		espressif,scl-pin = <2>;

		pinctrl-0 = <&i2c0_pins>;
		pinctrl-names = "default";

		rtc@51 {
			compatible = "nxp,pcf85063a";
			reg = <0x51>;
			interrupt-parent = <&gpio0>;
			interrupts = <1 IRQ_TYPE_EDGE_FALLING>;
			wakeup-source;
		};

		/*
		 * Hynitron CST9217 capacitive touch at 0x1A.
		 *
		 * The reset line is not an SoC GPIO: it is P08 of the XL9555
		 * expander, which comes up as an input, so the driver has to
		 * program it as an output before it can reset the part. The
		 * phandle below is what makes the driver wait for the expander to
		 * bind instead of writing to a line nobody is driving.
		 *
		 * Active low: asserting reset drives the line low, exactly as
		 * LilyGo's initTouch() does (low 20 ms, high 60 ms).
		 *
		 * TP_INT is GPIO 12: active low, pulsed when the controller has a
		 * report. LilyGo configures it as INPUT_PULLUP with a FALLING edge
		 * handler, which is what this mirrors -- the pull-up matters, and
		 * it is why the pin is in touch_int_pins below. The handler is
		 * threaded because servicing it reads I2C.
		 */
		touch@1a {
			compatible = "hynitron,cst92xx";
			reg = <0x1a>;
			reset-gpios = <&xl9555 8 GPIO_ACTIVE_LOW>;
			/*
			 * INT is requested as a GPIO and turned into an IRQ with
			 * gpiod_to_irq(), not through interrupt-parent/interrupts.
			 * The pull is set here rather than inherited.
			 */
			int-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
			pinctrl-0 = <&touch_int_pins>;
			pinctrl-names = "default";
			/*
			 * Idle poll, deliberately far longer than any plausible
			 * report interval.
			 *
			 * The controller self-reports about every 66 ms while a
			 * finger is down and asserts INT for each report, so while
			 * idle this timer should never be what discovers a touch --
			 * the interrupt is. 5000 ms is chosen to make that
			 * unambiguous: with values like 250 ms a broken interrupt
			 * still looks like working touch that is merely a bit
			 * sluggish, which is exactly the class of bug that hid for
			 * a session behind the full interrupt table. At 5 s a dead
			 * interrupt is not subtle -- a tap would take seconds to
			 * register -- while a working one still responds in about
			 * one report period.
			 *
			 * It is not removed entirely: this is the safety net that
			 * keeps touch from disappearing completely if the line ever
			 * stops asserting. A slow tap is recoverable, a dead screen
			 * is not. See TCH-010.
			 */
			hynitron,idle-poll-ms = <5000>;
		};

		/* XL9555: 16-bit GPIO expander, a PCA9555 clone at 0x20.
		 * Linear pin mapping: P00..P07 = gpio 0..7, P10..P17 = 8..15.
		 * It gates the display rail (P07), haptic enable (P06) and
		 * holds the touch controller out of reset (P08). No interrupt
		 * line on this board, so it is written only.
		 */
		xl9555: gpio@20 {
			compatible = "nxp,pca9555";
			reg = <0x20>;
			gpio-controller;
			#gpio-cells = <2>;

			/*
			 * P05 enables the radio module (LoRa / SX1262). It comes up
			 * as an input, and nothing else in the tree drives it, so
			 * the radio has never been powered while the SPI probe ran.
			 * Hog it high so the part is alive before SPI is tested.
			 */
			lora-enable-hog {
				gpio-hog;
				gpios = <5 GPIO_ACTIVE_HIGH>;
				output-high;
				line-name = "lora-enable";
			};
		};

		/* X-Powers AXP2101 PMU: battery, charging, and the power rails.
		 *
		 * The interrupt works and is wired: GPIO 7, active low, level
		 * triggered. A tap of Pusher A (the power key, which is not a GPIO
		 * and reaches Linux only through axp20x-pek) delivers press and
		 * release as separate sub-IRQs -- verified 2026-11-10, see PMU-004.
		 *
		 * This comment previously claimed "no interrupt" and warned that a
		 * LEVEL_LOW IRQ on GPIO 7 "storms and hangs the boot", which
		 * contradicted the node below it and is now known to be wrong for
		 * this configuration: the pin is held up by the weak pull-up in
		 * pmic_irq_pins, and with the interrupt connected the kernel boots
		 * and services presses normally. The warning is removed rather than
		 * left in place, because a comment that tells the next reader a
		 * working thing is dangerous is worse than no comment at all.
		 *
		 * What is genuinely absent, and unrelated to the interrupt: there is
		 * no wake-from-sleep path, which is a deferred item, not a defect
		 * here.
		 */
		pmic@34 {
			compatible = "x-powers,axp2101";
			reg = <0x34>;
			pinctrl-0 = <&pmic_irq_pins>;
			pinctrl-names = "default";
			interrupt-parent = <&gpio0>;
			interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
			interrupt-controller;
			#interrupt-cells = <1>;

			battery {
				compatible = "x-powers,axp2101-battery-power-supply";
			};

			usb_power: usb-power {
				compatible = "x-powers,axp2101-usb-power-supply";
			};

			/*
			 * Only DLDO1 is listed. Everything else in the PMU stays at
			 * its own default, which is how the board has worked so far.
			 *
			 * DLDO1 powers the ST25R3916 NFC reader. It comes up off, and
			 * the evidence is unambiguous: MISO (GPIO33) reads 0 even
			 * with its internal pull-up enabled, so something external is
			 * holding the line low -- an unpowered chip does exactly that
			 * through its ESD diodes. The bus and pin routing are
			 * therefore fine; the peripheral simply has no supply.
			 */
			regulators {
				nfc_vcc: dldo1 {
					regulator-name = "dldo1";
					regulator-min-microvolt = <3300000>;
					regulator-max-microvolt = <3300000>;
					regulator-always-on;
					regulator-boot-on;
				};
			};
		};
	};

	/*
	 * Display power, as a switchable regulator on the expander.
	 *
	 * The panel rail is enabled by XL9555 P07 and nothing else. There is no
	 * CO5300 driver yet, but modelling the enable here is what makes the
	 * kernel ASSERT it. Without it the pin keeps whatever state the
	 * previous firmware left: harmless across a warm reset, wrong on a
	 * cold boot, where the PCA9555 powers up all-inputs and the AMOLED
	 * stays dark.
	 *
	 * gpio 7 on the expander is P07 (linear numbering: P00..P07 = 0..7,
	 * P10..P17 = 8..15).
	 */
	/*
	 * The side buttons, named by position rather than by what LilyGo call
	 * them. "BOOT" describes what GPIO0 does during reset, not what the
	 * button is; the user presses it while wearing the watch.
	 *
	 * Pusher A is the top-left button. It is not a GPIO: it is the AXP2101
	 * power key, so it arrives through axp20x-pek (see the pmic node).
	 * Pusher B is the bottom-left button, GPIO0, active low.
	 * The recessed button by the USB port is the SoC's chip-enable and is
	 * not visible to software at all.
	 */
	gpio-keys {
		/* polled, not interrupt: the esp32 GPIO driver returns -ENXIO
		 * from gpiod_to_irq() for GPIO 0 (interrupts on pins 1 and 7
		 * work, so the irq domain itself is fine). Polling at 50 ms is
		 * what the ESP-IDF firmware does anyway.
		 */
		compatible = "gpio-keys-polled";
		pinctrl-0 = <&pusher_b_pins>;
		pinctrl-names = "default";
		poll-interval = <50>;
		autorepeat;

		pusher-b {
			label = "Pusher B";
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_ENTER>;
		};
	};

	display_vcc: regulator-display {
		compatible = "regulator-fixed";
		regulator-name = "display";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&xl9555 7 GPIO_ACTIVE_HIGH>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&iomux {
	status = "ok";

	i2c0_pins: i2c0_pins {
		pinctrl-single,pins = <
			PIN(3) FUN0_20MA_IE_WPU			/* SDA */
			PIN(2) FUN0_20MA_IE_WPU>;		/* SCL */
	};
	pusher_b_pins: pusher_b_pins {
		pinctrl-single,pins = <
			PIN(0) FUN0_20MA_IE_WPU>;		/* Pusher B, active low */
	};
	pmic_irq_pins: pmic_irq_pins {
		pinctrl-single,pins = <
			PIN(7) FUN0_20MA_IE_WPU>;		/* AXP2101 IRQ, open drain */
	};
	/* TP_INT, GPIO 12. LilyGo sets INPUT_PULLUP before attaching the
	 * falling-edge handler, so the weak pull-up is part of the contract and
	 * not a default worth inheriting: without it the line floats and the
	 * edge either never comes or comes continuously.
	 */
	touch_int_pins: touch_int_pins {
		pinctrl-single,pins = <
			PIN(12) FUN0_20MA_IE_WPU>;	/* CST9217 INT, active low */
	};
	/* The watch's panel is on SPI2 with its own pin set: SCK 40, data
	 * D0..D3 on 38, 39, 42, 45. FUN_SEL(4) is the SPI2 function. CS is a
	 * plain GPIO (41) driven by the panel driver, not a peripheral CS.
	 */
	spi2_pins: spi2_pins {
		pinctrl-single,pins = <
			PIN(40) (FUN_SEL(4) | FUN_DRV_20MA)	/* SCK */
			PIN(38) (FUN_SEL(4) | FUN_DRV_20MA)	/* D0 */
			PIN(39) (FUN_SEL(4) | FUN_DRV_20MA)	/* D1 */
			PIN(42) (FUN_SEL(4) | FUN_DRV_20MA)	/* D2 */
			PIN(45) (FUN_SEL(4) | FUN_DRV_20MA)>;	/* D3 */
	};
	uart0_pins: uart0_pins {
		pinctrl-single,pins = <
			PIN(43) FUN0_20MA			/* U0TXD */
			PIN(44) FUN0_20MA_IE_WPU>;		/* U0RXD */
	};
};

&gpio0 {
	status = "ok";
};

&uart0 {
	pinctrl-0 = <&uart0_pins>;
	pinctrl-names = "default";
	status = "ok";
};

/* SPI2 carries the panel. The controller does bind esp32-spi now: the command,
 * address and data phases are expressed as a spi_mem_op, which spi_transfer
 * cannot describe.
 */
&spi2 {
	status = "okay";

	/*
	 * SPI2 is what the working ESP-IDF firmware uses for this panel, and its
	 * peripheral is the one those register dumps came from. Its IO_MUX pins
	 * are GPIO 9..14, so the panel's 38..45 have to be routed through the
	 * GPIO matrix -- which is why the pin numbers live here and esp32-spi
	 * does the routing itself. (The devkit profile's spi2_pins node muxed
	 * these pads to FUN_SEL(4), which is not an SPI alternate on them.)
	 */
	espressif,clk-pin = <40>;
	espressif,d0-pin = <38>;
	espressif,d1-pin = <39>;
	espressif,d2-pin = <42>;
	espressif,d3-pin = <45>;

	panel@0 {
		compatible = "lilygo,co5300";
		reg = <0>;
		spi-max-frequency = <20000000>;
		/*
		 * Quad data. These two properties are what make the SPI core set
		 * SPI_TX_QUAD in spi->mode, which spi_mem_check_op then requires
		 * before it will accept a 4-lane phase. Without them a quad op is
		 * rejected with -EOPNOTSUPP before it reaches the controller.
		 */
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;

		/*
		 * CS is deliberately NOT "cs-gpios".
		 *
		 * spi_mem_exec_op() only calls the controller's ->exec_op when the
		 * device has no chip-select GPIO:
		 *
		 *   if (ctlr->mem_ops && ctlr->mem_ops->exec_op &&
		 *       !spi_get_csgpiod(mem->spi, 0))
		 *
		 * With cs-gpios present it silently falls back to building
		 * spi_transfers, which esp32-spi forces to single-bit -- so the
		 * quad path never ran. A different property name keeps CS under
		 * this driver's control without triggering that fallback, which
		 * is the same arrangement LilyGo use (spics_io_num = -1).
		 */
		lilygo,cs-gpios = <&gpio0 41 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio0 37 GPIO_ACTIVE_LOW>;
		te-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
	};
};



&spi3 {
	status = "disabled";
};

/ {
	spi_probe: spi-probe {
		compatible = "escapement,spi-probe";
		status = "disabled";
		/* NFC supply: DLDO1. Named here so the probe can assert it
		 * explicitly instead of assuming the PMU left it on. */
		vdd-supply = <&nfc_vcc>;
	};

};

&acm {
	status = "ok";
};

&ipc {
	wifi@1 {
		compatible = "esp,esp32-wifi-shmem";
		reg = <1>;
	};
};

&intc {
	reg = <0x600c2800 0x800>;
};
