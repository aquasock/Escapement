# Sources and toolchains: several GB, all reproducible from the pinned
# revisions in scripts/build.sh.
build/

# Upstream release blobs. scripts/fetch-images.sh downloads and verifies them.
images/*.bin

# Built by scripts/build-userspace.sh; deploy /home/blekbd, /home/panel-test
# and /home/tprobe
# on the watch with scripts/watch-deploy.sh.
userspace/blekbd
userspace/blekbd.strip
userspace/tprobe
userspace/panel-test

# Runtime session state. .codewhale/handoff.md is tracked deliberately, so the
# next agent can find the baton from a clean clone; the rest is per-session.
.codewhale/state/
# Cross-compiled from TamaHarness/portable; deploy /home/tamafb on the watch.
userspace/tamafb
userspace/romverify
userspace/fbtime
scripts/__pycache__/
userspace/memlat
userspace/storetest
userspace/tamafb_*
# Built by scripts/build-corebench.sh; deploy /home/corebench-* on the watch.
# corebench-flash is the one that runs here; see docs/tamagotchi.md.
userspace/corebench
userspace/corebench-flash
userspace/corebench-prof
userspace/corebench-rom
# Built by hand for the memory and code-footprint measurements.
userspace/codecost
