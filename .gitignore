# Sources and toolchains: several GB, all reproducible from the pinned
# revisions in scripts/build.sh.
build/

# nofrendo, fetched by scripts/nesbench.sh at a pinned retro-go commit. The
# firmware's copy is vendored in the tinydesk fork (ports/twatchultra/
# components/nofrendo); this one exists only so the benchmark can be rebuilt
# from scratch, and 8.5 MB of upstream GPL sources do not belong in this
# repository's history when the commit id reproduces them exactly.
third_party/nofrendo/

# gnuboy, fetched by scripts/gbcbench.sh at the same pinned retro-go commit. Same
# reasoning as nofrendo above: the sources are reproducible from the commit id,
# and this repository does not need 10 MB of upstream GPL code in its history.
third_party/gnuboy/

# binjgb, fetched by scripts/gbcbench.sh for the speed/accuracy comparison.
third_party/binjgb/

# PokeMini, vendored by tinytama and fetched by scripts/pmbench.sh.
third_party/pokemini/

# Upstream release blobs. scripts/fetch-images.sh downloads and verifies them.
images/*.bin

# Built by scripts/build-userspace.sh; deploy /home/blekbd, /home/panel-test
# /home/tprobe and /home/fbbench
# on the watch with scripts/watch-deploy.sh.
userspace/blekbd
userspace/blekbd.strip
userspace/tprobe
userspace/fbbench
userspace/tamafb-1x
userspace/panel-test

# Runtime session state. .codewhale/handoff.md is tracked deliberately, so the
# next agent can find the baton from a clean clone; the rest is per-session.
.codewhale/state/
# Cross-compiled from TamaHarness/portable; deploy /home/tamafb on the watch.
userspace/tamafb
userspace/romverify
userspace/fbtime
scripts/__pycache__/
userspace/memlat
userspace/storetest
userspace/tamafb_*
# Built by scripts/build-corebench.sh; deploy /home/corebench-* on the watch.
# corebench-flash is the one that runs here; see docs/tamagotchi.md.
userspace/corebench
userspace/corebench-flash
userspace/corebench-prof
userspace/corebench-rom
# Built by hand for the memory and code-footprint measurements.
userspace/codecost
