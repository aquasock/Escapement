#!/bin/sh
#
# S51panelclk - raise the CO5300 SPI clock after the panel driver has probed.
#
# The driver defaults to 20 MHz. That number came from the reference firmware,
# which recorded the panel shearing above it and dropped to 20 to cure it. Two
# things have changed since:
#
#   - The shearing had a cause that is now fixed. The SPI driver was re-sending
#     the command and address phases on every 64-byte chunk, which restarts the
#     CO5300's write pointer at the window origin. That is a write-pointer
#     desync, and it looks exactly like a clock-margin failure on the glass.
#   - It has been tested. Eight full-width bands, each a different colour, were
#     painted at 40 MHz and came out as eight clean bands in the right order --
#     which a desynced write pointer cannot do, because it would repeat the
#     first rows instead of reaching the bottom of the screen.
#
# So this sets 40 MHz at boot. 20 MHz cost 115 ms for a full 320x400 frame;
# 40 MHz costs 101 ms. That is only 13%, because the transfer is not actually
# clock bound -- the time goes into the 64-byte FIFO chunk loop -- but 13% is
# free and the panel is clean.
#
# If the panel ever does shear, this is the knob: lower the number here rather
# than rebuilding a kernel. 20000000 restores the old, proven-clean setting.
#
# Ordering: the panel driver is built in and probes before init runs, so by the
# time any rcS script executes the parameter exists. S50 keeps this after the
# touch daemon only by sort order; there is no real dependency between them.

PARAM=/sys/module/co5300/parameters/spi_hz
WANT=40000000

case "$1" in
start)
	printf 'Setting panel SPI clock: '
	if [ ! -e "$PARAM" ]; then
		# Not an error: a kernel built without the knob, or a boot where the
		# panel did not probe, both land here and neither is this script's
		# problem to solve.
		echo "SKIP (no $PARAM)"
		exit 0
	fi
	if echo "$WANT" > "$PARAM" 2>/dev/null; then
		echo "OK ($(cat "$PARAM") Hz)"
	else
		echo "FAIL"
	fi
	;;
status)
	if [ -e "$PARAM" ]; then
		echo "panel SPI clock: $(cat "$PARAM") Hz"
	else
		echo "panel SPI clock: no parameter (driver not loaded)"
	fi
	;;
*)
	echo "Usage: $0 {start|status}"
	exit 1
	;;
esac
